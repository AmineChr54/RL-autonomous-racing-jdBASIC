' playable.jdb - race the best evolved brain yourself (issue #56). Interpreted (needs the GFX window):
'   tools/jd.sh run playable.jdb [easy|hard]           arrow keys / WASD: steer + throttle, R restart, Esc quit (default track: hard)
'   tools/jd.sh run playable.jdb demo 400 out.png [level 0-3] [easy|hard]   autopilot for the human car (default: level 3, hard)
' Opponents (keys 1-4, made by train_brain.jdb): ROOKIE, PRO, EXPERT, CHAMPION = the best brain of evolution generation 3, 8, 15, 25.
' First car over one lap wins; a crash ends your run.
IMPORT TRACK, ENV, BRAIN, GUI

CONST LAP_TICKS_PER_SEC = 60

DIM gQuit AS INTEGER = 0
SUB OnQuit(info AS ARRAY)
    gQuit = 1
ENDSUB

DIM demo AS INTEGER = 0
DIM demoTicks AS INTEGER = 0
DIM shot$ = ""
DIM trackname$ = "hard"
IF LEN(OS.ARGS()) > 1 THEN
    IF OS.ARGS()[1] = "demo" THEN
        demo = 1
        demoTicks = CINT(VAL(OS.ARGS()[2]))
        shot$ = OS.ARGS()[3]
        IF LEN(OS.ARGS()) > 5 THEN trackname$ = OS.ARGS()[5]
    ELSE
        trackname$ = OS.ARGS()[1]
    ENDIF
ENDIF
IF trackname$ <> "easy" AND trackname$ <> "hard" THEN
    PRINT "playable: track must be easy or hard"
    END 2
ENDIF

DIM tr AS MAP = TRACK.NEW(trackname$)
DIM tl AS DOUBLE = tr{"length"}
DIM files$ = ["assets/brain_rookie.json", "assets/brain_pro.json", "assets/brain_expert.json", "assets/best_brain.json"]
DIM names$ = ["ROOKIE", "PRO", "EXPERT", "CHAMPION"]
DIM brs AS MAP = {}
DIM one AS ARRAY = [0]
DIM bi AS INTEGER = 0
FOR bi = 0 TO 3
    one = JSON.PARSE$(TXTREADER$(files$[bi]))
    brs{STR$(bi)} = BRAIN.PREP(RESHAPE(one + 0, [1, BRAIN.GENOME_SIZE()]))
NEXT bi
DIM lvl AS INTEGER = 3
IF demo = 1 AND LEN(OS.ARGS()) > 4 THEN lvl = CINT(VAL(OS.ARGS()[4]))
DIM br AS MAP = brs{STR$(lvl)}

DIM he AS MAP = ENV.NEW(tr, 1, 1000000, 0)        ' the human's car
DIM ae AS MAP = ENV.NEW(tr, 1, 1000000, 1)        ' the AI's car
DIM view AS MAP = {}                              ' both cars as one 2-car env, for GUI.DRAW_WORLD
view{"n"} = 3                                   ' you, AI, ghost of your best lap
view{"x"} = ZEROS([3])
view{"y"} = ZEROS([3])
view{"th"} = ZEROS([3])
view{"alive"} = ONES([3])
view{"progress"} = ZEROS([3])

DIM gui AS MAP = GUI.NEW(tr, 3)
ON "QUIT" CALL OnQuit

DIM hobs AS ARRAY = ENV.RESET(he)
DIM aobs AS ARRAY = ENV.RESET(ae)
DIM hact AS ARRAY = RESHAPE(ZEROS([2]), [1, 2])
DIM aact AS ARRAY = RESHAPE(ZEROS([2]), [1, 2])
DIM out AS ARRAY = BRAIN.FORWARD(br, aobs)
DIM ticks AS INTEGER = 0
DIM state AS INTEGER = 0          ' 0 racing, 1 you won, 2 AI won, 3 you crashed
DIM running AS INTEGER = 1
DIM f0 AS DOUBLE = 0.0
DIM steer AS DOUBLE = 0.0
DIM thr AS DOUBLE = 0.0
DIM hx AS ARRAY = he{"x"}
DIM hy AS ARRAY = he{"y"}
DIM hth AS ARRAY = he{"th"}
DIM hal AS ARRAY = he{"alive"}
DIM hpr AS ARRAY = he{"progress"}
DIM ax AS ARRAY = ae{"x"}
DIM ay AS ARRAY = ae{"y"}
DIM ath AS ARRAY = ae{"th"}
DIM aal AS ARRAY = ae{"alive"}
DIM apr AS ARRAY = ae{"progress"}
DIM vx AS ARRAY = view{"x"}
DIM vy AS ARRAY = view{"y"}
DIM vth AS ARRAY = view{"th"}
DIM val2 AS ARRAY = view{"alive"}
DIM vpr AS ARRAY = view{"progress"}
DIM px AS INTEGER = TRACK.WORLD_W
DIM best$ = "none yet"
DIM msg$ = ""
DIM demoRun AS INTEGER = 0

' ---- best laps (top 5, saved in ticks) and the ghost of the best one
CONST MAXT = 20000
DIM rx AS ARRAY = ZEROS([MAXT])
DIM ry AS ARRAY = ZEROS([MAXT])
DIM rth AS ARRAY = ZEROS([MAXT])
DIM gx AS ARRAY = ZEROS([MAXT])
DIM gy AS ARRAY = ZEROS([MAXT])
DIM gth AS ARRAY = ZEROS([MAXT])
DIM glen AS INTEGER = 0
DIM top AS ARRAY = ZEROS([5])
DIM ntop AS INTEGER = 0
DIM lines AS ARRAY = ["a"]
DIM li AS INTEGER = 0
MKDIR "saves"
IF FILE.EXISTS("saves/best_laps_" + trackname$ + ".txt") THEN
    lines = SPLIT(TXTREADER$("saves/best_laps_" + trackname$ + ".txt"), CHR$(10))
    FOR li = 0 TO LEN(lines) - 1
        IF LEN(lines[li]) > 0 AND ntop < 5 THEN
            top[ntop] = VAL(lines[li])
            ntop = ntop + 1
        ENDIF
    NEXT li
ENDIF
DIM gi AS INTEGER = 0
DIM sw AS DOUBLE = 0.0
DIM txt$ = ""

WHILE running = 1
    f0 = TICK()
    IF gQuit = 1 OR GFX.KEYSTATE("Escape") THEN running = 0
    FOR bi = 0 TO 3
        IF GFX.KEYSTATE(STR$(bi + 1)) AND lvl <> bi THEN
            lvl = bi
            br = brs{STR$(lvl)}
            hobs = ENV.RESET(he)
            aobs = ENV.RESET(ae)
            ticks = 0
            state = 0
        ENDIF
    NEXT bi
    IF GFX.KEYSTATE("R") THEN
        hobs = ENV.RESET(he)
        aobs = ENV.RESET(ae)
        ticks = 0
        state = 0
    ENDIF
    IF state = 0 THEN
        ' the AI always drives its brain
        out = BRAIN.FORWARD(br, aobs)
        aact[0, 0] = out[0, 0]
        aact[0, 1] = out[0, 1]
        aobs = ENV.TICK(ae, aact)
        IF demo = 1 THEN
            ' autopilot: a second brain copy drives the human car
            out = BRAIN.FORWARD(br, hobs)
            hact[0, 0] = out[0, 0] * 0.9
            hact[0, 1] = out[0, 1]
        ELSE
            steer = 0
            thr = 0
            IF GFX.KEYSTATE("Left") OR GFX.KEYSTATE("A") THEN steer = steer - 1
            IF GFX.KEYSTATE("Right") OR GFX.KEYSTATE("D") THEN steer = steer + 1
            IF GFX.KEYSTATE("Up") OR GFX.KEYSTATE("W") THEN thr = 1
            IF GFX.KEYSTATE("Down") OR GFX.KEYSTATE("S") THEN thr = -1
            hact[0, 0] = steer
            hact[0, 1] = thr
        ENDIF
        hobs = ENV.TICK(he, hact)
        IF ticks < MAXT THEN
            rx[ticks] = hx[0]
            ry[ticks] = hy[0]
            rth[ticks] = hth[0]
        ENDIF
        ticks = ticks + 1
        IF hal[0] = 0 THEN state = 3
        IF apr[0] >= tl AND state = 0 AND demo = 0 THEN state = 2
        IF hpr[0] >= tl THEN
            state = 1
            best$ = FORMAT$("{:.2f} s", ticks / LAP_TICKS_PER_SEC)
            ' insert into the top 5 (ascending ticks), keep the ghost when this is the new best
            IF ntop < 5 THEN
                top[ntop] = ticks
                ntop = ntop + 1
            ELSEIF ticks < top[4] THEN
                top[4] = ticks
            ENDIF
            FOR li = 0 TO ntop - 2
                FOR gi = 0 TO ntop - 2 - li
                    IF top[gi] > top[gi + 1] THEN
                        sw = top[gi]
                        top[gi] = top[gi + 1]
                        top[gi + 1] = sw
                    ENDIF
                NEXT gi
            NEXT li
            IF ticks = top[0] AND ticks < MAXT THEN
                glen = ticks
                FOR gi = 0 TO ticks - 1
                    gx[gi] = rx[gi]
                    gy[gi] = ry[gi]
                    gth[gi] = rth[gi]
                NEXT gi
            ENDIF
            txt$ = ""
            FOR li = 0 TO ntop - 1
                txt$ = txt$ + STR$(INT(top[li])) + CHR$(10)
            NEXT li
            TXTWRITER "saves/best_laps_" + trackname$ + ".txt", txt$
        ENDIF
    ENDIF
    vx[0] = hx[0]
    vy[0] = hy[0]
    vth[0] = hth[0]
    val2[0] = hal[0]
    vpr[0] = hpr[0]
    vx[1] = ax[0]
    vy[1] = ay[0]
    vth[1] = ath[0]
    val2[1] = aal[0]
    vpr[1] = apr[0]
    ' ghost: your best lap replayed (only while a race is running)
    val2[2] = 0
    IF glen > 0 AND state = 0 AND ticks < glen THEN
        vx[2] = gx[ticks]
        vy[2] = gy[ticks]
        vth[2] = gth[ticks]
        val2[2] = 1
        vpr[2] = ticks / glen * tl
    ENDIF
    GUI.DRAW_WORLD(gui, view)
    IF val2[2] = 1 THEN GUI.TXT "GHOST", vx[2] - 18, vy[2] - 26, 12, 0, 200, 200, 200
    GUI.TXT "YOU", hx[0] - 10, hy[0] - 26, 14, 1, 255, 255, 255
    GUI.TXT "AI", ax[0] - 6, ay[0] - 26, 14, 1, 120, 200, 255
    RECT px, 0, GUI.PANEL, GUI.WIN_H, TRUE, 22, 24, 29
    GUI.TXT "RACE THE AI - " + UCASE$(trackname$), px + 15, 10, 22, 1, 255, 214, 102
    GUI.TXT FORMAT$("time   {:6.2f} s", ticks / LAP_TICKS_PER_SEC), px + 15, 50, 18, 0, 225, 228, 235
    GUI.TXT FORMAT$("you    {:4.0f}%  of a lap", MIN([hpr[0] / tl * 100, 999])), px + 15, 80, 16, 0, 255, 255, 255
    GUI.TXT FORMAT$("AI     {:4.0f}%  of a lap", MIN([apr[0] / tl * 100, 999])), px + 15, 100, 16, 0, 120, 200, 255
    GUI.TXT "your best: " + best$, px + 15, 130, 16, 0, 225, 228, 235
    GUI.TXT "opponent: " + names$[lvl] + "  (keys 1-4)", px + 15, 150, 16, 0, 120, 200, 255
    GUI.TXT "BEST LAPS", px + 15, 185, 16, 1, 255, 214, 102
    FOR li = 0 TO ntop - 1
        GUI.TXT FORMAT$("{}. {:6.2f} s", li + 1, top[li] / LAP_TICKS_PER_SEC), px + 15, 210 + li * 20, 16, 0, 225, 228, 235
    NEXT li
    IF ntop = 0 THEN GUI.TXT "(finish a lap to set one)", px + 15, 210, 14, 0, 160, 165, 175
    GUI.TXT "Arrows / WASD drive   R restart   Esc quit", px + 15, 660, 13, 0, 160, 165, 175
    IF state = 1 THEN msg$ = "YOU WIN!"
    IF state = 2 THEN msg$ = "THE AI WINS - press R"
    IF state = 3 THEN msg$ = "CRASHED - press R"
    IF state > 0 THEN GUI.TXT msg$, 330, 320, 30, 1, 255, 255, 120
    IF demo = 1 AND state > 0 AND demoRun = 0 THEN
        ' demo: race once, then restart so the ghost of that run shows in the second one
        demoRun = 1
        hobs = ENV.RESET(he)
        aobs = ENV.RESET(ae)
        ticks = 0
        state = 0
    ELSEIF demo = 1 AND demoRun = 1 AND (ticks >= demoTicks OR state > 0) THEN
        GFX.SAVE_SCREENSHOT(shot$)
        running = 0
    ENDIF
    SCREENFLIP
    IF TICK() - f0 < 16 THEN GFX.DELAY(16 - (TICK() - f0))
WEND
