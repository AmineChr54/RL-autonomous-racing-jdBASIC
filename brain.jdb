' brain.jdb - the per-car brains used by neuroevolution.
'
' Every car has its OWN small network 8 -> 12 -> 12 -> 2 (tanh everywhere), stored as one row of
' 290 numbers called a "genome". The genomes of the whole swarm are one N x 290 matrix.
'
' Python runs all N networks at once with torch.baddbmm (a batched matrix multiply). jdBasic has no
' 3-D matmul, so each layer is done with three plain 2-D MATMULs instead, still for all cars at once:
'     X  (N x in)      --MATMUL E-->   every input repeated `out` times        (N x in*out)
'     .* W (N x in*out)                every car's own weight on its own input
'     --MATMUL S-->    sum over the inputs of each output                      (N x out)
'     + b, tanh
' E and S are fixed 0/1 matrices. The weights W, b are cut out of the genomes once per generation
' (PREP), so a tick is 9 MATMULs and a few element-wise ops.
'
' Genome layout per layer, as in brain.py: in*out weights (index in*out_size + out), then out biases.

EXPORT MODULE BRAIN
IMPORT TORCH

EXPORT CONST N_LAYERS = 3
EXPORT CONST GENOME = 290          ' 8*12+12 + 12*12+12 + 12*2+2

' layer sizes [8, 12, 12, 2]
EXPORT FUNC SIZES() AS ARRAY
    RETURN [8, 12, 12, 2]
ENDFUNC

EXPORT FUNC GENOME_SIZE() AS INTEGER
    DIM s AS ARRAY = SIZES()
    DIM total AS INTEGER = 0
    DIM l AS INTEGER = 0
    FOR l = 0 TO N_LAYERS - 1
        total = total + s[l] * s[l + 1] + s[l + 1]
    NEXT l
    RETURN total
ENDFUNC

' Xavier-style random starting brains, N x 290: weights ~ N(0, sqrt(2 / (in + out))), biases 0
EXPORT FUNC RANDOM_GENOMES(n, gen) AS ARRAY
    DIM s AS ARRAY = SIZES()
    DIM scale AS ARRAY = TORCH.ZEROS_RC(1, GENOME)
    DIM p AS INTEGER = 0
    DIM l AS INTEGER = 0
    DIM j AS INTEGER = 0
    DIM sd AS DOUBLE = 0.0
    FOR l = 0 TO N_LAYERS - 1
        sd = SQR(2.0 / (s[l] + s[l + 1]))
        FOR j = 0 TO s[l] * s[l + 1] - 1
            scale[0, p + j] = sd
        NEXT j
        p = p + s[l] * s[l + 1] + s[l + 1]
    NEXT l
    DIM g AS ARRAY = TORCH.RANDN(gen, n, GENOME) * TORCH.REPROW(scale, n)
    RETURN g
ENDFUNC

' Under -c every whole-array temporary (MATMUL, *, TANH, ...) leaks until the program ends, so a per-tick
' forward pass built from array ops eats gigabytes. FORWARD therefore uses scalar loops that write into
' buffers allocated once per generation by PREP (like env.jdb does).
EXPORT FUNC PREP(genomes AS ARRAY) AS MAP
    DIM n AS INTEGER = LEN(genomes)
    DIM br = {}
    DIM g AS ARRAY = genomes
    DIM h1 AS ARRAY = TORCH.ZEROS_RC(n, 12)
    DIM h2 AS ARRAY = TORCH.ZEROS_RC(n, 12)
    DIM o AS ARRAY = TORCH.ZEROS_RC(n, 2)
    br{"G"} = g
    br{"n"} = n
    br{"h1"} = h1
    br{"h2"} = h2
    br{"out"} = o
    RETURN br
ENDFUNC

' one layer for all cars: xout[c, j] = tanh(sum_i xin[c, i] * W_c[i, j] + b_c[j]); the genome row holds
' the ni*no weights (index i*no + j) from column off, then the no biases
SUB Layer(g AS ARRAY, n AS INTEGER, off AS INTEGER, ni AS INTEGER, no AS INTEGER, xin AS ARRAY, xout AS ARRAY)
    DIM c AS INTEGER = 0
    DIM i AS INTEGER = 0
    DIM j AS INTEGER = 0
    DIM acc AS DOUBLE = 0.0
    DIM bo AS INTEGER = off + ni * no
    FOR c = 0 TO n - 1
        FOR j = 0 TO no - 1
            acc = g[c, bo + j]
            FOR i = 0 TO ni - 1
                acc = acc + xin[c, i] * g[c, off + i * no + j]
            NEXT i
            xout[c, j] = TANH(acc)
        NEXT j
    NEXT c
ENDSUB

' run every car's own network on its own observation: obs N x 8 -> actions N x 2 (a buffer owned by br,
' overwritten by the next call)
EXPORT FUNC FORWARD(br AS MAP, obs AS ARRAY) AS ARRAY
    DIM g AS ARRAY = br{"G"}
    DIM h1 AS ARRAY = br{"h1"}
    DIM h2 AS ARRAY = br{"h2"}
    DIM o AS ARRAY = br{"out"}
    DIM n AS INTEGER = br{"n"}
    Layer(g, n, 0, 8, 12, obs, h1)
    Layer(g, n, 108, 12, 12, h1, h2)
    Layer(g, n, 264, 12, 2, h2, o)
    RETURN o
ENDFUNC

' activations of every layer for ONE car (one: its genome, a 1-D row of 290, obs: a 1-D row of 8), for the
' brain visualiser: {"n": 4, "0": obs, "1": hidden 1, "2": hidden 2, "3": output}
EXPORT FUNC ACTS(one AS ARRAY, obs AS ARRAY) AS MAP
    DIM br AS MAP = PREP(RESHAPE(one, [1, GENOME]))
    DIM x AS ARRAY = RESHAPE(obs, [1, LEN(obs)])
    DIM g AS ARRAY = br{"G"}
    DIM h1 AS ARRAY = br{"h1"}
    DIM h2 AS ARRAY = br{"h2"}
    DIM o AS ARRAY = br{"out"}
    Layer(g, 1, 0, 8, 12, x, h1)
    Layer(g, 1, 108, 12, 12, h1, h2)
    Layer(g, 1, 264, 12, 2, h2, o)
    DIM acts = {}
    acts{"0"} = obs
    acts{"1"} = h1[0]
    acts{"2"} = h2[0]
    acts{"3"} = o[0]
    acts{"n"} = N_LAYERS + 1
    RETURN acts
ENDFUNC
