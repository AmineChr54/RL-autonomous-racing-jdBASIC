' train_brain.jdb: train neuroevolution headless and save the best genome as the AI opponent of playable.jdb.
'   tools/jd.sh native train_brain.jdb 25          generations (about 5 s each, native) -> assets/best_brain.json
IMPORT TRACK, ENV, EVOLUTION
DIM gens AS INTEGER = 25
IF LEN(OS.ARGS()) > 1 THEN gens = CINT(VAL(OS.ARGS()[1]))
DIM tr AS MAP = TRACK.NEW("hard")
DIM e AS MAP = ENV.NEW(tr, 200, 900, 0)
DIM ev AS MAP = EVOLUTION.NEW(e, 0)
DIM hb AS ARRAY = [0]
WHILE ev{"generation"} <= gens
    IF EVOLUTION.ADVANCE(ev) = 1 THEN
        hb = ev{"hist_best"}
        PRINT "gen "; LEN(hb); "  best "; INT(hb[LEN(hb) - 1]); " px"
    ENDIF
WEND
TXTWRITER "assets/best_brain.json", EVOLUTION.SAVE_JSON$(ev)
PRINT "saved assets/best_brain.json"
