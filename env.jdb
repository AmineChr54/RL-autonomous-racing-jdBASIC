' env.jdb - a swarm of cars driving on the track, simulated all at once.
'
' Each step every car gets two numbers from its brain:
'     steer    in [-1, 1]   (left ... right)
'     throttle in [-1, 1]   (brake ... gas)
' and sees 8 numbers back (the observation): 7 distance rays + its own speed.
'
' An env is a map of flat per-car arrays (booleans are stored as 0 / 1).
' TICK fills e{"obs"} (N x 8), e{"reward"}, e{"done"} and e{"timeout"} in place.
' State is rounded to float32 (CSNG) like the numpy original, so both versions drive alike.

EXPORT MODULE ENV
IMPORT TRACK, RAND

EXPORT CONST OBS_DIM = 8
EXPORT CONST ACT_DIM = 2
EXPORT CONST VMAX = 6.0           ' pixels per step
CONST ACC = 0.35
CONST DRAG = 0.02
CONST MAX_TURN = 0.12             ' radians per step at full steer
EXPORT CONST N_RAYS = 7
EXPORT CONST RAY_RANGE = 120.0
CONST RAY_STEP = 4.0
CONST N_SAMPLES = 30              ' RAY_RANGE / RAY_STEP
CONST STALL_LIMIT = 70            ' steps without new progress before the car is "stuck"
EXPORT CONST CRASH_PENALTY = 5.0
EXPORT CONST PROGRESS_SCALE = 0.1 ' reward per pixel travelled forward

' -90 -60 -30 0 30 60 90 degrees, rounded to float32 like np.deg2rad(..., float32)
EXPORT FUNC RAY_ANGLE(r) AS DOUBLE
    RETURN CSNG((r - 3) * 30 * MATH.PI / 180)
ENDFUNC

EXPORT FUNC NEW(tr AS MAP, n = 200, max_steps = 1200, seed = 0) AS MAP
    DIM e = {}
    e{"track"} = tr
    e{"n"} = n
    e{"max_steps"} = max_steps
    e{"auto_reset"} = 0
    e{"random_start"} = 0
    e{"noise"} = 1                       ' 0 = no start noise (parity tests)
    e{"rng"} = RAND.GENERATOR(seed + 1)
    e{"x"} = ZEROS([n])
    e{"y"} = ZEROS([n])
    e{"th"} = ZEROS([n])
    e{"v"} = ZEROS([n])
    e{"alive"} = ONES([n])
    e{"progress"} = ZEROS([n])          ' px travelled forward (can be > 1 lap)
    e{"best_progress"} = ZEROS([n])
    e{"stall"} = ZEROS([n])
    e{"steps"} = ZEROS([n])
    e{"s_idx"} = ZEROS([n])
    e{"crashed"} = ZEROS([n])
    e{"obs"} = RESHAPE(ZEROS([n * OBS_DIM]), [n, OBS_DIM])   ' 2-D ZEROS is quadratic in memory under -c
    e{"reward"} = ZEROS([n])
    e{"done"} = ZEROS([n])
    e{"timeout"} = ZEROS([n])
    e{"dist"} = ZEROS([n * N_RAYS])
    DIM ra AS ARRAY = ZEROS([N_RAYS])
    DIM r AS INTEGER = 0
    FOR r = 0 TO N_RAYS - 1
        ra[r] = RAY_ANGLE(r)
    NEXT r
    e{"ray_angles"} = ra
    ' episodes that ended since the last CLEAR_FINISHED (for RL stats): count, sum, max of best_progress
    e{"fin_count"} = 0
    e{"fin_sum"} = 0.0
    e{"fin_max"} = 0.0
    RESET_ALL(e, 1)
    OBSERVE(e)
    RETURN e
ENDFUNC

' ------------------------------------------------------------------ reset
SUB ResetOne(e AS MAP, i AS INTEGER, force_start AS INTEGER)
    DIM tr AS MAP = e{"track"}
    DIM g AS INTEGER = e{"rng"}
    DIM start AS INTEGER = 0
    IF e{"random_start"} <> 0 AND force_start = 0 THEN
        start = CINT(RAND.INTRANGE(g, 0, tr{"n"} - 1))
    ENDIF
    DIM nx AS DOUBLE = 0.0
    DIM ny AS DOUBLE = 0.0
    DIM nt AS DOUBLE = 0.0
    IF e{"noise"} <> 0 THEN
        ' small random offset so cars aren't identical clones
        nx = RAND.NORMAL(g, 0, 3)
        ny = RAND.NORMAL(g, 0, 3)
        nt = RAND.NORMAL(g, 0, 0.05)
    ENDIF
    e{"x"}[i] = CSNG(tr{"cx"}[start] + nx)
    e{"y"}[i] = CSNG(tr{"cy"}[start] + ny)
    e{"th"}[i] = CSNG(tr{"heading"}[start] + nt)
    e{"v"}[i] = 2.0
    e{"alive"}[i] = 1
    e{"progress"}[i] = 0
    e{"best_progress"}[i] = 0
    e{"stall"}[i] = 0
    e{"steps"}[i] = 0
    e{"crashed"}[i] = 0
    e{"s_idx"}[i] = start
ENDSUB

EXPORT SUB RESET_IDX(e AS MAP, i AS INTEGER)
    ResetOne(e, i, 0)
ENDSUB

EXPORT SUB RESET_ALL(e AS MAP, force_start AS INTEGER)
    DIM i AS INTEGER = 0
    FOR i = 0 TO e{"n"} - 1
        ResetOne(e, i, force_start)
    NEXT i
ENDSUB

' reset every car (random starts if random_start is on) and return the observation
EXPORT FUNC RESET(e AS MAP) AS ARRAY
    DIM force AS INTEGER = 1
    IF e{"random_start"} <> 0 THEN force = 0
    RESET_ALL(e, force)
    CLEAR_FINISHED(e)
    OBSERVE(e)
    RETURN e{"obs"}
ENDFUNC

EXPORT SUB CLEAR_FINISHED(e AS MAP)
    e{"fin_count"} = 0
    e{"fin_sum"} = 0.0
    e{"fin_max"} = 0.0
ENDSUB

' ---------------------------------------------------------------- sensing
FUNC RoadAt(mask AS ARRAY, px AS DOUBLE, py AS DOUBLE) AS INTEGER
    DIM ix AS INTEGER = CINT(px)          ' truncates toward zero like astype(int32)
    DIM iy AS INTEGER = CINT(py)
    IF ix < 0 OR ix >= TRACK.WORLD_W OR iy < 0 OR iy >= TRACK.WORLD_H THEN
        RETURN 0
    ENDIF
    IF mask[iy * TRACK.WORLD_W + ix] <> 0 THEN
        RETURN 1
    ENDIF
    RETURN 0
ENDFUNC

' e{"dist"}[i * 7 + r] = distance to the wall along each ray, in pixels; marches to the first off-road sample
EXPORT SUB RAY_DISTANCES(e AS MAP)
    DIM mask AS ARRAY = e{"track"}{"mask"}
    DIM xs AS ARRAY = e{"x"}
    DIM ys AS ARRAY = e{"y"}
    DIM th AS ARRAY = e{"th"}
    DIM ra AS ARRAY = e{"ray_angles"}
    DIM dist AS ARRAY = e{"dist"}
    DIM n AS INTEGER = e{"n"}
    DIM W AS INTEGER = TRACK.WORLD_W
    DIM H AS INTEGER = TRACK.WORLD_H
    DIM i AS INTEGER = 0
    DIM r AS INTEGER = 0
    DIM s AS INTEGER = 0
    DIM ix AS INTEGER = 0
    DIM iy AS INTEGER = 0
    DIM x0 AS DOUBLE = 0.0
    DIM y0 AS DOUBLE = 0.0
    DIM a AS DOUBLE = 0.0
    DIM dx AS DOUBLE = 0.0
    DIM dy AS DOUBLE = 0.0
    DIM t AS DOUBLE = 0.0
    DIM d AS DOUBLE = 0.0
    FOR i = 0 TO n - 1
        x0 = xs[i]
        y0 = ys[i]
        FOR r = 0 TO N_RAYS - 1
            a = CSNG(th[i] + ra[r])
            dx = CSNG(COS(a))
            dy = CSNG(SIN(a))
            d = RAY_RANGE
            FOR s = 1 TO N_SAMPLES
                t = s * RAY_STEP
                ix = CINT(CSNG(x0 + CSNG(dx * t)))
                iy = CINT(CSNG(y0 + CSNG(dy * t)))
                IF ix < 0 OR ix >= W OR iy < 0 OR iy >= H THEN
                    d = (s - 1) * RAY_STEP + RAY_STEP / 2
                    EXITFOR
                ENDIF
                IF mask[iy * W + ix] = 0 THEN
                    d = (s - 1) * RAY_STEP + RAY_STEP / 2
                    EXITFOR
                ENDIF
            NEXT s
            dist[i * N_RAYS + r] = d
        NEXT r
    NEXT i
ENDSUB

EXPORT FUNC OBSERVE(e AS MAP) AS ARRAY
    RAY_DISTANCES(e)
    DIM obs AS ARRAY = e{"obs"}
    DIM dist AS ARRAY = e{"dist"}
    DIM v AS ARRAY = e{"v"}
    DIM i AS INTEGER = 0
    DIM r AS INTEGER = 0
    FOR i = 0 TO e{"n"} - 1
        FOR r = 0 TO N_RAYS - 1
            obs[i, r] = CSNG(dist[i * N_RAYS + r] / RAY_RANGE)
        NEXT r
        obs[i, N_RAYS] = CSNG(v[i] / VMAX)
    NEXT i
    RETURN obs
ENDFUNC

' ------------------------------------------------------------------ step
' Advance all cars one tick. actions is N x 2 (steer, throttle). Returns the new observation.
EXPORT FUNC TICK(e AS MAP, act AS ARRAY) AS ARRAY
    DIM tr AS MAP = e{"track"}
    DIM mask AS ARRAY = tr{"mask"}
    DIM idxm AS ARRAY = tr{"idx"}
    DIM n_pts AS INTEGER = tr{"n"}
    DIM half AS INTEGER = n_pts \ 2
    DIM ds AS DOUBLE = tr{"ds"}
    DIM xs AS ARRAY = e{"x"}
    DIM ys AS ARRAY = e{"y"}
    DIM th AS ARRAY = e{"th"}
    DIM vs AS ARRAY = e{"v"}
    DIM alive AS ARRAY = e{"alive"}
    DIM prog AS ARRAY = e{"progress"}
    DIM best AS ARRAY = e{"best_progress"}
    DIM stall AS ARRAY = e{"stall"}
    DIM steps AS ARRAY = e{"steps"}
    DIM sidx AS ARRAY = e{"s_idx"}
    DIM crashed AS ARRAY = e{"crashed"}
    DIM rew AS ARRAY = e{"reward"}
    DIM done AS ARRAY = e{"done"}
    DIM tout AS ARRAY = e{"timeout"}
    DIM n AS INTEGER = e{"n"}
    DIM max_steps AS INTEGER = e{"max_steps"}
    DIM W AS INTEGER = TRACK.WORLD_W
    DIM H AS INTEGER = TRACK.WORLD_H
    DIM auto AS INTEGER = e{"auto_reset"}
    DIM i AS INTEGER = 0
    DIM a AS INTEGER = 0
    DIM steer AS DOUBLE = 0.0
    DIM thr AS DOUBLE = 0.0
    DIM v AS DOUBLE = 0.0
    DIM turn AS DOUBLE = 0.0
    DIM crash AS INTEGER = 0
    DIM ix AS INTEGER = 0
    DIM iy AS INTEGER = 0
    DIM s_new AS INTEGER = 0
    DIM d AS INTEGER = 0
    DIM dprog AS DOUBLE = 0.0
    DIM stuck AS INTEGER = 0
    DIM tmo AS INTEGER = 0
    DIM bad AS INTEGER = 0
    FOR i = 0 TO n - 1
        a = CINT(alive[i])
        steer = act[i, 0]
        IF steer < -1 THEN steer = -1
        IF steer > 1 THEN steer = 1
        thr = act[i, 1]
        IF thr < -1 THEN thr = -1
        IF thr > 1 THEN thr = 1
        crash = 0
        d = 0
        IF a = 1 THEN
            ' one CSNG per numpy float32 operation keeps the arithmetic bit-exact
            v = CSNG(CSNG(vs[i] + CSNG(thr * ACC)) - CSNG(DRAG * vs[i]))
            IF v < 0 THEN v = 0
            IF v > VMAX THEN v = VMAX
            vs[i] = v
            turn = CSNG(CSNG(steer * MAX_TURN) * CSNG(0.35 + CSNG(CSNG(0.65 * v) / VMAX)))
            th[i] = CSNG(th[i] + turn)
            xs[i] = CSNG(xs[i] + CSNG(v * CSNG(COS(th[i]))))
            ys[i] = CSNG(ys[i] + CSNG(v * CSNG(SIN(th[i]))))
            ' crash: centre or nose of the car outside the road
            IF RoadAt(mask, xs[i], ys[i]) = 0 THEN
                crash = 1
            ELSEIF RoadAt(mask, CSNG(xs[i] + CSNG(CSNG(COS(th[i])) * 8)), CSNG(ys[i] + CSNG(CSNG(SIN(th[i])) * 8))) = 0 THEN
                crash = 1
            ENDIF
            IF crash = 0 THEN
                ' progress along the track (nearest centerline index, wrap-aware)
                ix = CINT(xs[i])
                IF ix < 0 THEN ix = 0
                IF ix > W - 1 THEN ix = W - 1
                iy = CINT(ys[i])
                IF iy < 0 THEN iy = 0
                IF iy > H - 1 THEN iy = H - 1
                s_new = CINT(idxm[iy * W + ix])
                d = s_new - CINT(sidx[i]) + half
                d = ((d MOD n_pts) + n_pts) MOD n_pts - half      ' floor-mod like Python's %
                sidx[i] = s_new
            ENDIF
        ELSE
            vs[i] = 0
        ENDIF
        dprog = d * ds
        prog[i] = CSNG(prog[i] + CSNG(dprog))
        IF prog[i] > best[i] + 0.5 THEN
            best[i] = prog[i]
            stall[i] = 0
        ELSE
            stall[i] = stall[i] + 1
        ENDIF
        steps[i] = steps[i] + a
        stuck = 0
        tmo = 0
        IF a = 1 AND crash = 0 THEN
            IF stall[i] > STALL_LIMIT THEN
                stuck = 1
            ELSEIF steps[i] >= max_steps THEN
                tmo = 1
            ENDIF
        ENDIF
        bad = 0
        IF crash = 1 OR stuck = 1 THEN bad = 1
        IF bad = 1 THEN crashed[i] = 1
        rew[i] = CSNG(dprog * PROGRESS_SCALE - CRASH_PENALTY * bad)
        done[i] = 0
        IF bad = 1 OR tmo = 1 THEN done[i] = 1
        tout[i] = tmo
        IF a = 1 AND done[i] = 0 THEN
            alive[i] = 1
        ELSE
            alive[i] = 0
        ENDIF
    NEXT i
    IF auto <> 0 THEN
        FOR i = 0 TO n - 1
            IF done[i] <> 0 THEN
                e{"fin_count"} = e{"fin_count"} + 1
                e{"fin_sum"} = e{"fin_sum"} + best[i]
                IF e{"fin_count"} = 1 OR best[i] > e{"fin_max"} THEN e{"fin_max"} = best[i]
                ResetOne(e, i, 0)
            ENDIF
        NEXT i
    ENDIF
    RETURN OBSERVE(e)
ENDFUNC

' ------------------------------------------------------------- utilities
' evolution fitness = furthest distance travelled along the track
EXPORT FUNC FITNESS(e AS MAP) AS ARRAY
    RETURN e{"best_progress"} + 0
ENDFUNC

EXPORT FUNC ALL_DEAD(e AS MAP) AS INTEGER
    DIM alive AS ARRAY = e{"alive"}
    IF SUM(alive) = 0 THEN RETURN 1
    RETURN 0
ENDFUNC

' index of the car that is furthest along among the living (-1 if nobody lives)
EXPORT FUNC LEADER(e AS MAP) AS INTEGER
    DIM alive AS ARRAY = e{"alive"}
    DIM prog AS ARRAY = e{"progress"}
    DIM bi AS INTEGER = -1
    DIM i AS INTEGER = 0
    FOR i = 0 TO e{"n"} - 1
        IF alive[i] <> 0 THEN
            IF bi < 0 THEN
                bi = i
            ELSEIF prog[i] > prog[bi] THEN
                bi = i
            ENDIF
        ENDIF
    NEXT i
    RETURN bi
ENDFUNC
